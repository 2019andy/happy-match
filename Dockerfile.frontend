# 构建阶段
FROM node:18-alpine AS builder

WORKDIR /app

# 复制源代码
COPY . .

# 安装依赖并构建
RUN npm install && npm run build

# 运行阶段
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制Nginx配置
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

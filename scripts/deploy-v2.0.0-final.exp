#!/usr/bin/expect -f

# 甜趣点点消 v2.0.0 自动化部署脚本
# 作者: AI Deploy Assistant
# 日期: 2026-06-09

set timeout 600
set SERVER_IP "114.132.69.85"
set SERVER_USER "root"
set SERVER_PASS "Ubuntu123"

puts ""
puts "======================================================================"
puts "           甜趣点点消 v2.0.0 自动化部署系统"
puts "======================================================================"
puts ""
puts " [配置信息]"
puts "   服务器: $SERVER_IP"
puts "   用户: $SERVER_USER"
puts "   项目目录: /opt/happy-match"
puts "   远程仓库: https://github.com/2019andy/happy-match.git"
puts ""
puts "======================================================================"
puts ""
puts " [阶段 1/6] 连接远程服务器..."
puts ""

spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null $SERVER_USER@$SERVER_IP

expect {
    "password:" {
        send "$SERVER_PASS\r"
    }
    timeout {
        puts " ❌ 错误: 连接超时"
        exit 1
    }
    "Connection refused" {
        puts " ❌ 错误: 连接被拒绝"
        exit 1
    }
}

expect -re {#|>|\\\$}
puts " ✅ 服务器连接成功"
puts ""

puts "======================================================================"
puts ""
puts " [阶段 2/6] 检查项目目录和Git状态..."
puts ""

send "cd /opt/happy-match && pwd && echo 'DIR_OK'\r"
expect -re {#|>|\\\$}

send "git status --short | wc -l\r"
expect -re {#|>|\\\$}

send "git log --oneline -3\r"
expect -re {#|>|\\\$}
puts " ✅ Git状态检查完成"
puts ""

puts "======================================================================"
puts ""
puts " [阶段 3/6] 从GitHub拉取最新代码 (v2.0.0)..."
puts ""

send "git checkout main 2>&1 | tail -3\r"
expect -re {#|>|\\\$}

send "git pull origin main 2>&1 | tail -10\r"
expect -re {#|>|\\\$}

send "echo '---最新提交---' && git log --oneline -2\r"
expect -re {#|>|\\\$}

puts " ✅ 代码拉取完成"
puts ""

puts "======================================================================"
puts ""
puts " [阶段 4/6] 停止旧服务..."
puts ""

send "echo '检查现有进程:' && ps aux | grep -E '(tsx|node)' | grep -v grep | wc -l\r"
expect -re {#|>|\\\$}

send "pkill -f 'tsx api/server.ts' 2>/dev/null; pkill -f 'node' 2>/dev/null; sleep 2\r"
expect -re {#|>|\\\$}

send "echo '停止后进程数:' && ps aux | grep -E '(tsx|node)' | grep -v grep | wc -l\r"
expect -re {#|>|\\\$}
puts " ✅ 旧服务已停止"
puts ""

puts "======================================================================"
puts ""
puts " [阶段 5/6] 安装依赖并启动新服务..."
puts ""

send "mkdir -p /var/log/happy-match\r"
expect -re {#|>|\\\$}

send "cd /opt/happy-match && npm install 2>&1 | tail -5\r"
expect -re {#|>|\\\$}
puts "   - 依赖安装完成"

send "cd /opt/happy-match && nohup npx tsx api/server.ts > /var/log/happy-match/api-server.log 2>&1 &\r"
expect -re {#|>|\\\$}
puts "   - 服务启动命令已发送"

send "sleep 12\r"
expect -re {#|>|\\\$}
puts "   - 等待服务启动完成 (12秒)"
puts " ✅ 新服务已启动"
puts ""

puts "======================================================================"
puts ""
puts " [阶段 6/6] 验证部署状态..."
puts ""

send "echo '' && echo '===== 进程检查 =====' && ps aux | grep -E '(tsx|node)' | grep -v grep\r"
expect -re {#|>|\\\$}

send "echo '' && echo '===== 端口检查 =====' && (netstat -tlnp 2>/dev/null || ss -tlnp) | grep 3001 || echo '  端口未找到'\r"
expect -re {#|>|\\\$}

send "echo '' && echo '===== API响应测试 =====' && curl -s --connect-timeout 15 http://localhost:3001/api/admin/users 2>&1 | head -40\r"
expect -re {#|>|\\\$}

send "echo '' && echo '===== 服务日志 =====' && tail -35 /var/log/happy-match/api-server.log\r"
expect -re {#|>|\\\$}

puts ""
puts "======================================================================"
puts ""
puts "           ✅ v2.0.0 自动化部署完成!"
puts ""
puts " [部署信息]"
puts "   API地址: http://114.132.69.85:3001/api/admin/users"
puts "   管理后台: http://114.132.69.85:3001"
puts "   服务器日志: /var/log/happy-match/api-server.log"
puts ""
puts " [本地管理命令]"
puts "   查看实时日志: ssh root@114.132.69.85 'tail -f /var/log/happy-match/api-server.log'"
puts "   重启服务: bash /opt/happy-match/scripts/restart-server.sh"
puts "   验证状态: bash /opt/happy-match/scripts/verify-deploy.sh"
puts ""
puts "======================================================================"
puts ""

send "exit\r"
expect eof
